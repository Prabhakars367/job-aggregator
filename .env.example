# Database Configuration
# For local SQLite: sqlite:///./jobs.db
# For production (e.g. PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./jobs.db

# FastAPI Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# App Secret Key (for sessions/security if needed later)
SECRET_KEY=your-secret-key-here
